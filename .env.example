# ==============================================================================
# CONFIGURAÇÕES GERAIS DA APLICAÇÃO
# ==============================================================================
APP_NAME="MedVault Crypto API"
APP_ENV="development"
APP_DEBUG=true
APP_HOST="0.0.0.0"
APP_PORT=8000
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]'

# ==============================================================================
# BANCO DE DADOS (PostgreSQL via asyncpg no Docker / SQLite Async local opcional)
# ==============================================================================
DATABASE_URL="postgresql+asyncpg://medvault:medvault_secret@localhost:5432/medvault_db"

# ==============================================================================
# SEGREDOS CRIPTOGRÁFICOS (PEPPERs E CHAVES DO SERVIDOR)
# Importante: Nunca salve os Peppers no banco de dados! Eles ficam apenas em
# variáveis de ambiente / Secret Manager / KMS.
# ==============================================================================
# Pepper mestre usado na derivação de chaves por usuário (HKDF-SHA256 -> AES-256-GCM)
APP_ENCRYPTION_PEPPER="demo-master-encryption-pepper-change-in-prod-9f8e7d6c5b4a3210"

# Pepper dedicado para o pré-hash (HMAC-SHA256) antes do Argon2id nas senhas
APP_PASSWORD_PEPPER="demo-password-secret-pepper-change-in-prod-1a2b3c4d5e6f7a8b"

# Pepper dedicado para geração de Blind Indexes (HMAC-SHA256) para busca exata (CPF, Email, Tipo Sanguíneo)
APP_BLIND_INDEX_PEPPER="demo-blind-index-pepper-change-in-prod-7f6e5d4c3b2a1908"

# ==============================================================================
# AUTENTICAÇÃO JWT
# ==============================================================================
JWT_SECRET_KEY="demo-jwt-secret-key-change-in-production-32bytes-minimum"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
